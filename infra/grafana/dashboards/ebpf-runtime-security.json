{
  "title": "PHANTOM — eBPF Runtime Security & Event Capture",
  "tags": [
    "phantom",
    "ebpf",
    "security",
    "kernel"
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "version": 1,
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data Source",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Total eBPF Events Captured",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum(phantom_ebpf_events_captured_total)",
          "legendFormat": "Total Events",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 2,
      "title": "Ring Buffer Drop Rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(phantom_ebpf_ringbuf_reserve_failures_total[5m])",
          "legendFormat": "Drop Rate (/sec)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.0001
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Event Rate by Type",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (event_type) (rate(phantom_ebpf_events_captured_total[1m]))",
          "legendFormat": "{{event_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Event Rate by Node",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (node_name) (rate(phantom_ebpf_events_captured_total[1m]))",
          "legendFormat": "{{node_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Event Capture Lag",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(phantom_ebpf_event_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99 Capture Lag",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Ring Buffer Saturation Gauge",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum(rate(phantom_ebpf_ringbuf_reserve_failures_total[5m])) / (sum(rate(phantom_ebpf_events_captured_total[5m])) + sum(rate(phantom_ebpf_ringbuf_reserve_failures_total[5m])) + 1e-5) * 100",
          "legendFormat": "Saturation %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1.0
              }
            ]
          }
        },
        "overrides": []
      }
    }
  ]
}