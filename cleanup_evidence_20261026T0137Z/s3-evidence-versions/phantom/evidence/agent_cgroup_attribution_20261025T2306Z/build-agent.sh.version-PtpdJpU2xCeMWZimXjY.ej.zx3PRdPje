#!/usr/bin/env bash
set -euo pipefail
WORK=/tmp/phantom-agent-cgroup-attribution-20261025T2306Z
mkdir -p "$WORK"
base64 -d > "$WORK/agent-source.tar.gz" <<'PHANTOM_ARCHIVE'

PHANTOM_ARCHIVE
printf '%s  %s\n' 'e58c8ba6686aaa23a7057e0bc02a78b48a114bde800d08f6c86f1eb84f0b4393' "$WORK/agent-source.tar.gz" | sha256sum -c -
tar -xzf "$WORK/agent-source.tar.gz" -C "$WORK"
cd "$WORK/services/ebpf-agent"
docker build --pull=false -f Dockerfile -t phantom/ebpf-agent:cgroupattr-20261025T2306Z .
docker save phantom/ebpf-agent:cgroupattr-20261025T2306Z | sudo -n k3s ctr -n k8s.io images import -
sudo -n kubectl -n phantom set image daemonset/phantom-ebpf-agent phantom-agent=phantom/ebpf-agent:cgroupattr-20261025T2306Z
sudo -n kubectl -n phantom rollout status daemonset/phantom-ebpf-agent --timeout=240s
sudo -n kubectl -n phantom get daemonset phantom-ebpf-agent -o jsonpath='image={.spec.template.spec.containers[0].image} ready={.status.numberReady}/{.status.desiredNumberScheduled}\n'
