# ============================================================================
# PHANTOM — Required Environment Variables
# ============================================================================
# Copy this file to .env and populate with your local values.
# .env is gitignored and MUST NOT be committed.
# All secrets MUST be set via environment variables; never hardcode them.
# ============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL (shared by all Python services)
# ---------------------------------------------------------------------------
POSTGRES_USER=phantom
POSTGRES_PASSWORD=
POSTGRES_DB=phantom
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Per-service connection DSNs (asyncpg format)
SBOM_SERVICE_DB_URL=postgresql://phantom:@localhost:5432/phantom
CAUSAL_ENGINE_DB_URL=postgresql://phantom:@localhost:5432/phantom
API_GATEWAY_DB_URL=postgresql://phantom:@localhost:5432/phantom
REPORT_GENERATOR_DB_URL=postgresql://phantom:@localhost:5432/phantom

# ---------------------------------------------------------------------------
# Redis (event streams, WebSocket fan-out, caching)
# ---------------------------------------------------------------------------
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_URL=redis://:@localhost:6379/0

# Per-service Redis URLs
API_GATEWAY_REDIS_URL=redis://:@localhost:6379/0
CAUSAL_ENGINE_REDIS_URL=redis://:@localhost:6379/0
REPORT_GENERATOR_REDIS_URL=redis://:@localhost:6379/0

# Redis stream names
CAUSAL_ENGINE_STREAM_NAME=phantom:drift-events
CAUSAL_ENGINE_CONSUMER_GROUP=causal-engine-workers
REPORT_GENERATOR_STREAM_NAME=phantom:report-tasks

# ---------------------------------------------------------------------------
# API Gateway
# ---------------------------------------------------------------------------
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8080

# JWT / JWKS authentication
API_GATEWAY_JWKS_URI=
API_GATEWAY_JWT_AUDIENCE=
API_GATEWAY_JWT_ISSUER=

# Internal service base URLs (for HTTP routing)
SBOM_SERVICE_BASE_URL=http://localhost:8000
CAUSAL_ENGINE_BASE_URL=http://localhost:8001
REPORT_GENERATOR_BASE_URL=http://localhost:8002

# ---------------------------------------------------------------------------
# SBOM Service
# ---------------------------------------------------------------------------
SBOM_SERVICE_HOST=0.0.0.0
SBOM_SERVICE_PORT=8000

# S3-compatible object store for SBOM artifacts
SBOM_SERVICE_S3_BUCKET=phantom-sbom-artifacts
SBOM_SERVICE_S3_ENDPOINT_URL=
SBOM_SERVICE_S3_ACCESS_KEY_ID=
SBOM_SERVICE_S3_SECRET_ACCESS_KEY=
SBOM_SERVICE_S3_REGION=ap-south-1

# cosign binary path
COSIGN_PATH=cosign

# ---------------------------------------------------------------------------
# Causal Engine
# ---------------------------------------------------------------------------
CAUSAL_ENGINE_HEALTH_PORT=8001

# PCEPS XGBoost model
PCEPS_MODEL_PATH=

# ---------------------------------------------------------------------------
# Report Generator
# ---------------------------------------------------------------------------
REPORT_GENERATOR_HEALTH_PORT=8002

# S3-compatible object store for rendered reports
REPORT_GENERATOR_S3_BUCKET=phantom-reports
REPORT_GENERATOR_S3_ENDPOINT_URL=
REPORT_GENERATOR_S3_ACCESS_KEY_ID=
REPORT_GENERATOR_S3_SECRET_ACCESS_KEY=
REPORT_GENERATOR_S3_REGION=ap-south-1

# ---------------------------------------------------------------------------
# Prometheus / Grafana (local dev)
# ---------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console
