{
  "title": "PHANTOM — Runtime SBOM Drift & Compliance Posture",
  "tags": [
    "phantom",
    "sbom",
    "drift",
    "compliance",
    "cosign"
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "version": 1,
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data Source",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Total Runtime SBOM Drifts Detected",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum(phantom_sbom_drift_detected_total)",
          "legendFormat": "Total Drifts",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "id": 2,
      "title": "Active Violations by Type",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (violation_type) (rate(phantom_contract_violations_total[5m]))",
          "legendFormat": "{{violation_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Identity Resolution Success Rate",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum(rate(phantom_identity_resolution_total{status=\"resolved\"}[5m])) / (sum(rate(phantom_identity_resolution_total[5m])) + 1e-5) * 100",
          "legendFormat": "Resolved %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 90.0
              },
              {
                "color": "green",
                "value": 99.0
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "SBOM Verification Status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(phantom_sbom_verification_total[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Outbox Publishing Lag",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(phantom_outbox_publish_failures_total[5m])",
          "legendFormat": "Publish Failures (/sec)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Drift Remediation Time p50/p90/p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(phantom_drift_remediation_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(phantom_drift_remediation_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(phantom_drift_remediation_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    }
  ]
}
